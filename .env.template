# 百度统计
NEXT_PUBLIC_BAIDU_TONGJI=
NEXT_PUBLIC_BAIDU_KEY=

# 谷歌
NEXT_PUBLIC_GOOGLE_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION_ID=

# Rabbit
NEXT_PUBLIC_RYBBIT_TONGJI=
NEXT_PUBLIC_RYBBIT_TONGJI_SITEID=

# 跳转到哪个服务
NEXT_PUBLIC_HOME_URL=
NEXT_PUBLIC_USER_URL=
# Static publication profile: cn, io, or preview.
NEXT_PUBLIC_SITE_VARIANT=io
NEXT_PUBLIC_CN_HOME_URL=https://fastgpt.cn
NEXT_PUBLIC_IO_HOME_URL=https://fastgpt.io

# Lead attribution CRM API base URL, e.g. https://crm.example.com/api/v1
NEXT_PUBLIC_CRM_API_URL=
# Default business source for Home submissions without ?source=...
NEXT_PUBLIC_ATTRIBUTION_SOURCE=

# 备案号
NEXT_PUBLIC_FILING_ADDRESS=
# 公安备案号
NEXT_PUBLIC_POLICE_FILING=

# 展示FAQ
NEXT_PUBLIC_FAQ=true

# Customer Stories Center (/customers) —— 迁移进 home 项目后的客户案例中心
# These variables are read only by the server unless marked NEXT_PUBLIC_*.

# 站点公开地址（SEO 关键）：canonical / og:url / sitemap / JSON-LD 均以此为准，必须带 /customers 前缀。
SITE_URL=https://fastgpt.cn/customers
# 脚本/工具基准地址，与最终公开挂载地址一致（本地开发可用 http://localhost:3000/customers）。
HOST=https://fastgpt.cn/customers

# MongoDB 连接串，库名指向迁移后的 fastgpt-customers（含 customers / customerinteractions 等集合）。
MONGODB_URI=

# AI 生成能力（案例 AI 摘要、AI 问答、AI 配图、封面搜索等）
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Pexels 图库 API（案例封面 / 配图搜索）
PEXELS_API_KEY=

# S3 对象存储（案例封面、正文图片、媒体文件上传）
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# 后台登录密码（/customers/admin 登录用）
ADMIN_PASSWORD=
# Agent 写接口鉴权密钥（/customers/api/v1/* 写操作）
AGENT_API_KEY=
# 商务咨询表单（POC / 联系表单）提交到的 CRM 后端地址
CONTACT_API_BASE_URL=

# 后台开关：仅在要对外暴露 /customers/admin 的部署实例上设为 true。
# 生产建议双实例部署：公网 3000 实例保持 false，后台 3001 实例设为 true。
CUSTOMERS_ADMIN_ENABLED=false
