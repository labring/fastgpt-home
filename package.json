{
  "name": "fastgpt",
  "version": "4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-robots.js && node scripts/generate-llms.js",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "test:customers": "vitest run",
    "customers:import-cases": "tsx scripts/customers/import-case-pages.ts",
    "customers:backfill-slugs": "tsx scripts/customers/backfill-solution-slugs.ts",
    "customers:apply-english-slugs": "tsx scripts/customers/apply-english-slugs.ts",
    "customers:sync-db-indexes": "tsx scripts/customers/sync-db-indexes.ts",
    "customers:verify-seo": "tsx scripts/customers/verify-case-seo.ts",
    "customers:verify-db": "tsx scripts/customers/verify-db-indexes.ts",
    "prepare": "husky",
    "format-code": "prettier --config \"./.prettierrc.js\" --write \"./**/src/**/*.{ts,tsx,scss}\"",
    "clean-locales": "node scripts/clean-locales.js",
    "convert-images": "node scripts/convert-images.js",
    "verify:p0": "node scripts/verify-p0.js",
    "verify:p1": "node scripts/verify-p1.js",
    "verify:p2": "node scripts/verify-p2.js",
    "verify:i18n-seo": "node scripts/verify-i18n-seo.js",
    "verify:deep-content": "node scripts/verify-deep-content.js",
    "verify:faq-routes": "node scripts/verify-faq-routes.js",
    "verify:faq-redirects": "node scripts/verify-faq-redirects.js",
    "verify:faq-metadata": "node scripts/verify-faq-metadata.js",
    "verify:faq-seo-graph": "node scripts/verify-faq-seo-graph.js",
    "verify:release": "node scripts/verify-release.js",
    "verify:release-regression": "node --test scripts/verify-release.test.js",
    "sync:w3-faq": "python3 scripts/sync-w3-faq.py",
    "verify:contact": "node scripts/verify-contact-page.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1043.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^2.8.9",
    "@heroui/theme": "^2.4.26",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.24",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cobe": "^2.0.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "eventsource-parser": "^3.0.8",
    "framer-motion": "^12.34.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.16.1",
    "mongoose": "^9.7.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pinyin-match": "^1.2.10",
    "postcss": "^8.5.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.0.1",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "textarea-caret": "^3.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "20.19.33",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/textarea-caret": "^3.0.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.3",
    "jsdom": "^29.1.1",
    "pinyin-pro": "^3.28.2",
    "prettier": "^2.8.8",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
